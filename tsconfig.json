{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"types": ["jest", "node"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"]
		},
		"allowImportingTsExtensions": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
